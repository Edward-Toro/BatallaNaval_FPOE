<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="580.0" prefWidth="1200.0" styleClass="game-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.batallanaval_fpoe.controller.ShipPlacementController">

   <children>
      <!-- ════════════════════ NAV BAR ════════════════════ -->
      <HBox alignment="CENTER" prefHeight="57.0" styleClass="nav-bar">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <ImageView fitHeight="60.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@Asset%20-8.png" />
                     </image>
                     <viewport>
                        <Rectangle2D />
                     </viewport>
                     <HBox.margin>
                        <Insets bottom="10.0" left="24.0" right="16.0" top="10.0" />
                     </HBox.margin>
                  </ImageView>
               </children>
            </HBox>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label styleClass="board-title" text="Configura tu flota">
               <HBox.margin>
                  <Insets right="24.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>

      <!-- ════════════════════ CONTENT ════════════════════ -->
      <HBox alignment="CENTER" spacing="0" VBox.vgrow="ALWAYS">

         <!-- ────── Board ────── -->
         <VBox alignment="CENTER" styleClass="board-section" HBox.hgrow="ALWAYS">
            <children>
               <Label styleClass="board-title" text="Tu tablero" />
               <StackPane fx:id="boardStack" alignment="CENTER" styleClass="board-panel" VBox.vgrow="ALWAYS">
                  <children>
                     <VBox alignment="CENTER" styleClass="isometric-grid" />
                  </children>
               </StackPane>
            </children>
            <HBox.margin>
               <Insets left="16.0" />
            </HBox.margin>
         </VBox>
         <HBox minWidth="420.0" prefWidth="420.0" styleClass="side-panel" HBox.hgrow="NEVER">
            <children>
               <VBox minWidth="180.0" prefWidth="190.0" HBox.hgrow="ALWAYS">
                  <children>
                     <Label styleClass="board-title" text="Flota disponible" />
                     <VBox fx:id="shipPalette" spacing="8" />
                  </children>
               </VBox>

                     <!-- ────── Separator ────── -->
               <Region maxWidth="12.0" prefHeight="453.0" prefWidth="12.0" styleClass="board-separator" HBox.hgrow="NEVER">
                  <HBox.margin>
                     <Insets left="8.0" right="12.0" />
                  </HBox.margin>
               </Region>
               <VBox minWidth="190.0" prefWidth="200.0" spacing="10" HBox.hgrow="ALWAYS">
                  <children>
                     <Label fx:id="lblOrientation" styleClass="turn-indicator" text="Orientación: Horizontal">
                        <VBox.margin>
                           <Insets top="4.0" />
                        </VBox.margin>
                     </Label>
                     <Button maxWidth="Infinity" onAction="#toggleOrientation" styleClass="btn-primary" text="Rotar (R)">
                        <VBox.margin>
                           <Insets bottom="6.0" />
                        </VBox.margin>
                     </Button>
                     <Label fx:id="lblProgress" styleClass="turn-indicator" text="0 / 10 barcos colocados">
                        <VBox.margin>
                           <Insets top="6.0" />
                        </VBox.margin>
                     </Label>

                     <Button fx:id="btnAutoPlace" maxWidth="Infinity" onAction="#autoPlace" styleClass="btn-primary" text="Aleatorio">
                        <VBox.margin>
                           <Insets top="2.0" bottom="2.0" />
                        </VBox.margin>
                     </Button>
                     <Button fx:id="btnClear" maxWidth="Infinity" onAction="#clearBoard" styleClass="btn-danger" text="Limpiar tablero">
                        <VBox.margin>
                           <Insets top="2.0" bottom="6.0" />
                        </VBox.margin>
                     </Button>
                     <Region prefHeight="180.0" prefWidth="163.0" VBox.vgrow="ALWAYS" />
                     <Button fx:id="btnStart" disable="true" maxWidth="Infinity" onAction="#startGame" prefHeight="54.0" styleClass="btn-success" text="¡Iniciar Partida!" textAlignment="CENTER" wrapText="true">
                        <VBox.margin>
                           <Insets bottom="4.0" />
                        </VBox.margin>
                     </Button>
                  </children>
               </VBox>
            </children>
         </HBox>
      </HBox>
      <HBox alignment="CENTER" spacing="16" styleClass="status-bar">
         <children>
            <Label fx:id="lblStatus" text="Arrastra los barcos al tablero - R para rotar - Click derecho para quitar" />
         </children>
      </HBox>
   </children>
</VBox>
